#!/usr/bin/env bash
# Make knarf speak.
#   talk "Hello there"      queue text and return immediately
#   echo hi | talk          read text from stdin
#   talk -w "text"          wait until it has been spoken
#   talk --stop             stop speaking and clear the queue
#   talk --status           is knarf running / speaking?
#   talk --toggle           show or hide the circle (starts knarf if it isn't running)
#   talk --quit             quit knarf (the systemd service keeps it running otherwise)
#   talk --listen           listen to the mic and type what you say into the focused window
#                           (run again while listening to stop early)
# If the knarf window isn't running, falls back to the plain `say` script.
URL="http://127.0.0.1:${KNARF_PORT:-47820}"
WAIT=0
case "$1" in
  --stop)   exec curl -fsS -X POST "$URL/stop" >/dev/null ;;
  --listen) exec curl -fsS -X POST "$URL/listen" >/dev/null ;;
  --quit)   exec curl -fsS -X POST "$URL/quit" >/dev/null ;;
  --toggle)
    if curl -fsS -m 1 "$URL/status" >/dev/null 2>&1; then exec curl -fsS -X POST "$URL/toggle" >/dev/null
    elif systemctl --user cat knarf.service >/dev/null 2>&1; then exec systemctl --user start knarf.service
    else setsid -f "$HOME/.local/bin/knarf" >/dev/null 2>&1; exit 0; fi ;;
  --status) curl -fsS "$URL/status" && echo || { echo "knarf not running"; exit 1; }; exit 0 ;;
  -w|--wait) WAIT=1; shift ;;
esac
if [ $# -gt 0 ]; then TEXT="$*"; else TEXT="$(cat)"; fi
[ -z "${TEXT// }" ] && exit 0
if ! printf '%s' "$TEXT" | curl -fsS -X POST --data-binary @- "$URL/say?wait=$WAIT" >/dev/null 2>&1; then
  echo "talk: knarf not running, using say" >&2
  exec "$HOME/.local/share/piper/say" "$TEXT"
fi
